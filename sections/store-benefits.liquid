<section class="store-benefits">
    <h2>{{ section.settings.heading | escape }}</h2>

    <ul class="store-benefits__list">
        {% for block in section.blocks %}
            {% if block.type == "benefit" %}
                <li {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape}}
                </li>
            {% endif %}
        {% endfor %}
    </ul>

</section>

{% schema %}
{
    "name": "store benefits",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Why Shop With Us?"
        }
    ],
    "blocks": [
        {
            "type": "benefit",
            "name":"Benefit",
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text",
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Store Benefits"
        }
    ]

}
{% endschema %}

{% stylesheet %}
  .store-benefits {
    padding: 24px;
    align-items: center;
  }
  .store-benefits__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .store-benefits__list li {
    background-color: #f1f5f9;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
  }
  .store-benefits h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  @media (max-width: 767px) {
    .store-benefits__list {
        grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}